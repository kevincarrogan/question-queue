Screen {
    background: $background;
}

#where {
    color: $text-muted;
    padding: 0 1;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#keys {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#panes {
    height: 1fr;
}

.-narrow #panes {
    layout: vertical;
}

/* Whichever pane has the focus gets the bright border: that's the mode. */

#outline, #editor {
    width: 1fr;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    background: transparent;
}

#outline:focus, #editor:focus-within {
    border: round $accent;
}

#outline > .option-list--option-highlighted {
    background: $accent 25%;
    text-style: bold;
}

#outline:blur > .option-list--option-highlighted {
    background: $accent 12%;
}

#outline > .option-list--option-disabled {
    color: $text;
}

#outline.-moving > .option-list--option-highlighted {
    background: $primary 60%;
}

#text {
    height: 1fr;
    border: none;
    background: transparent;
    padding: 0;
}

#text > .text-area--cursor-line {
    background: transparent;
}

#text > .text-area--gutter {
    color: $text-muted;
}

ChoiceModal, HelpModal {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog .choices {
    margin-top: 1;
    color: $text-muted;
}

/* The command line takes the key bar's place while it's open, as in vim. */

#command {
    dock: bottom;
    height: 1;
    display: none;
    background: $panel;
}

#command-line {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
}

#command-hint {
    width: auto;
    max-width: 60%;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.help {
    width: 84;
}
